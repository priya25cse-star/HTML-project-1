{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build:frontend",
  "outputDirectory": "frontend-dist",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://gourmet-catering-backend.onrender.com/api/:path*"
    }
  ]
}
