      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "const body=pm.response.json();pm.collectionVariables.set('orderId',body.orderId);pm.test('Uses authoritative menu price',function(){pm.expect(body.total).to.eql(Number(pm.collectionVariables.get('breadPrice'))*2);});"
            ]
          }
        }
      ]
