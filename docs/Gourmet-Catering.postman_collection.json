{
  "info": {
    "name": "Gourmet au Catering - Third Evaluation",
    "description": "Run in order. Set adminUsername/adminPassword locally from .env; enable cookies. Actual menu and MongoDB writes occur. Use fictional data; sample records are deleted by later requests. Recipes require network access. Bread Basket must exist and be available.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "adminUsername",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "csrfToken",
      "value": ""
    },
    {
      "key": "menuId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Health - inspect database field",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Public menu - capture authoritative bread price",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/menu"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "const bread=pm.response.json().find(x=>x.id==='bread-basket'); if(bread) pm.collectionVariables.set('breadPrice',bread.price);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Admin login - cookie and CSRF",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.collectionVariables.set('csrfToken',pm.response.json().csrfToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Current admin",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Create JSON menu item",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/menu",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"evaluation-postman-{{$timestamp}}\",\n  \"name\": \"Evaluation seasonal soup\",\n  \"category\": \"kitchen\",\n  \"description\": \"Fictional sample dish for demonstrating persistent JSON CRUD.\",\n  \"price\": 8.25,\n  \"image\": \"/assets/garden.jpg\",\n  \"available\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('menuId',pm.response.json().id);"
            ]
          }
        }
      ]
    },
