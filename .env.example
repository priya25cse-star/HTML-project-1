# Copy these settings into .env. Preserve any existing configuration.
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/gourmet_catering
ADMIN_USERNAME=admin
# Choose your own password (at least 12 characters). No default password exists.
ADMIN_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
NODE_ENV=development
# Enable only behind a trusted reverse proxy in production.
TRUST_PROXY=0
