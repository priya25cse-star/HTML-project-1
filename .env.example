# Application port (Render sets this dynamically, default 3000 locally)
PORT=3000

# MongoDB Atlas connection string:
# Format: mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/gourmet_catering?retryWrites=true&w=majority
# Make sure to percent-encode special characters in password (e.g. @ becomes %40)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/gourmet_catering?retryWrites=true&w=majority

# Admin credentials
ADMIN_USERNAME=admin
# Choose your own password (at least 12 characters). setup.js generates a random one if omitted.
ADMIN_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Environment mode: 'development' or 'production'
NODE_ENV=development

# Set to 1 when running behind a reverse proxy (e.g., Render, Vercel, Nginx)
TRUST_PROXY=0

# Frontend URL when deployed on Vercel (for CORS allowance on backend)
# Example: https://gourmet-catering.vercel.app
FRONTEND_URL=

# Optional comma-separated list of allowed origins (e.g. https://my-site.vercel.app,http://localhost:5173)
ALLOWED_ORIGINS=

# Cookie SameSite setting: 'strict' for same-domain, 'none' for cross-domain over HTTPS
COOKIE_SAMESITE=strict
